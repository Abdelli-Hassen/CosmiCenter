# ── CosmiCenter — configuration (copier en .env puis adapter) ─────────────────
FLASK_APP=app.py
FLASK_ENV=development
# Le débogueur Werkzeug n'est activé que si FLASK_HOST est une adresse locale (127.0.0.1).
# Dès que le serveur est exposé au réseau (0.0.0.0), il est automatiquement désactivé.
FLASK_DEBUG=False
# 127.0.0.1 = ce poste uniquement ; 0.0.0.0 = partagé sur le réseau local (tests par d'autres personnes)
FLASK_HOST=127.0.0.1
FLASK_PORT=8080

# Clé secrète : OBLIGATOIRE (valeur aléatoire longue, ex: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=
# Optionnel : clé de chiffrement des mots de passe AnyDesk/TeamViewer (sinon dérivée de SECRET_KEY)
# FIELD_ENCRYPTION_KEY=

# Base de données PostgreSQL
DATABASE_URL=postgresql://UTILISATEUR:testtest@localhost:5432/NOM_BASE

# Derrière Nginx (déploiement Ubuntu, voir DEPLOYMENT_GUIDE.md) : true ; FLASK_HOST doit alors rester 127.0.0.1
BEHIND_PROXY=false

# URL publique utilisée dans les liens des emails (sinon l'hôte de la requête est utilisé)
# PUBLIC_BASE_URL=http://192.168.1.20:8080

# Cookies : mettre true uniquement derrière HTTPS
SESSION_COOKIE_SECURE=false

# Sécurité des comptes : verrouillage temporaire après N échecs de connexion
MAX_LOGIN_ATTEMPTS=7
LOCKOUT_DURATION_MINUTES=30

# Upload de fichiers (chemin relatif au dossier du projet). À laisser dans static/ : les images sont servies
# par l'adresse /static/uploads/... ; un chemin absolu vers un autre disque enregistrerait les fichiers mais ne les afficherait pas.
UPLOAD_FOLDER=static/uploads

# Email sortant (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@example.com
SUPPORT_EMAIL=support@example.com

# Autres paramètres
TIMEZONE=Africa/Tunis
LANGUAGE=fr
